<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#33FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih Layanan WhatsApp"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Pilih salah satu untuk chat admin langsung"
        android:textColor="@color/text_gray"
        android:textSize="14sp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:columnCount="2">

        <!-- Wedding -->
        <LinearLayout
            android:id="@+id/optionWaWedding"
            style="@style/WaOptionItem">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Wedding"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Wisuda -->
        <LinearLayout
            android:id="@+id/optionWaWisuda"
            style="@style/WaOptionItem">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Wisuda"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Pas Photo -->
        <LinearLayout
            android:id="@+id/optionWaPasPhoto"
            style="@style/WaOptionItem">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pas Photo"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Cuci Cetak -->
        <LinearLayout
            android:id="@+id/optionWaCetak"
            style="@style/WaOptionItem">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_save"
                app:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cuci Cetak"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Edit Photo -->
        <LinearLayout
            android:id="@+id/optionWaEdit"
            style="@style/WaOptionItem">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Edit Photo"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Lainnya -->
        <LinearLayout
            android:id="@+id/optionWaLainnya"
            style="@style/WaOptionItem">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_help"
                app:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Lainnya"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

    </GridLayout>

</LinearLayout>